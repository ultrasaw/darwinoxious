{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "@PROJECTS_DIR@/**", "effect": "allow" },
    { "action": "external_directory", "resource": "@HOME@/go/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/Applications/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/**", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "gcloud *", "effect": "ask" },
    { "action": "shell", "resource": "firebase *", "effect": "ask" }
  ],
  "experimental": {
    "todo": true
  }
}
